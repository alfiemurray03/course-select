{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "course-select",
  "compatibility_date": "2026-08-03",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "course-select",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
    }
  ]
}
